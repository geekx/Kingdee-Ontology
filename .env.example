# 复制这份文件为 .env，把下面几项填上——.env 已经在 .gitignore / .dockerignore 里，
# 不会进仓库、也不会进镜像。
#
# 4 项都是必填。本服务只支持账号密码(ValidateUser)登录，不需要创建第三方应用、
# 不需要 AppID / AppSecret（0.2.0 起如此，见 README「从旧版迁移」）。
#
# 用法：
#   python3 -m kingdee_ontology.setup_check     先跑一遍自检——配置读对了吗、
#                                                连得上吗、这个账号能碰到哪些模块
#   python3 -m kingdee_ontology.base.server      装好、自检通过后启动底座服务端
#
# 找这份文件的顺序：$KINGDEE_ENV_FILE（显式指定）→ 当前目录的 .env → 主目录的
# .kingdee-mcp.env（换了项目也不用重填一遍）。已经通过 MCP 客户端自己的方式
# 配置了环境变量的，这份文件不会覆盖它——文件是兜底，不是真理来源。

# ── 金蝶云星空连接（必填 4 项）────────────────────────────────
# 地址结尾必须带 /k3cloud/，少了这一段登录会 404
KINGDEE_SERVER_URL=http://your-server/k3cloud/
KINGDEE_ACCT_ID=你的账套ID
KINGDEE_USERNAME=金蝶账号
KINGDEE_PASSWORD=金蝶账号密码
# 语言，2052=简体中文（可不填，默认 2052）
KINGDEE_LCID=2052

# 可选：多租户/二开覆盖层用哪一份 profiles/<租户>/profile.yml，留空用底座默认注册表
# KINGDEE_TENANT=example-tenant

# ── 传输方式（容器里一般不用改，compose 已设好）─────────────────
# KINGDEE_MCP_TRANSPORT=streamable-http   # stdio / sse / streamable-http
# KINGDEE_MCP_HOST=0.0.0.0
# KINGDEE_MCP_PORT=8000

# ── SQL Server 直连探查（可选，不用就整段留空）──────────────────
# MCP_SQLSERVER_HOST=
# MCP_SQLSERVER_PORT=1433
# MCP_SQLSERVER_DATABASE=
# MCP_SQLSERVER_USER=
# MCP_SQLSERVER_PASSWORD=
# MCP_SQLSERVER_SCHEMA=dbo
# MCP_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server

# 可选：更多环境变量（KINGDEE_STRICT_LINKS / …）见 README
