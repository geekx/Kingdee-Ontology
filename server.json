{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.geekx/kingdee-mcp",
  "title": "Kingdee K3Cloud (Cloud Galaxy) ERP",
  "description": "Open-source MCP server for Kingdee K3Cloud ERP - 101 tools, 17 domains. Unofficial.",
  "version": "0.4.0",
  "repository": {
    "url": "https://github.com/geekx/Kingdee-Ontology",
    "source": "github"
  },
  "websiteUrl": "https://wahailong.github.io/KingdeeMCP/",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "kingdee-mcp",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "KINGDEE_SERVER_URL",
          "description": "Kingdee K3Cloud server base URL, must end with /k3cloud/ (e.g. http://your-server/k3cloud/)",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "KINGDEE_ACCT_ID",
          "description": "Kingdee account set (data center) ID",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "KINGDEE_USERNAME",
          "description": "Kingdee login user name (ValidateUser login)",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "KINGDEE_PASSWORD",
          "description": "Kingdee login password (ValidateUser login)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
